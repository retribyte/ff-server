meta {
  name: Replace portrait settings
  type: http
  seq: 1
}

put {
  url: http://localhost:3000/api/admin/portrait/settings
  body: json
  auth: inherit
}

body:json {
  {
    "categories": ["animal"],
    "races": [{ "id": "human", "descriptor": "Human", "category": "animal" }],
    "curation": { "hideItemPattern": "invisi", "hideItems": [], "itemsOnlyFor": {}, "erase": {} }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
