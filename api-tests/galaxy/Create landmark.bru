meta {
  name: Create landmark
  type: http
  seq: 4
}

post {
  url: http://localhost:3000/api/galaxy/places
  body: json
  auth: inherit
}

body:json {
  {
    "kind": "LANDMARK",
    "name": "Test Beacon",
    "category": "station",
    "x": 0,
    "y": 30,
    "z": 2
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
