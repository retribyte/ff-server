meta {
  name: Create system
  type: http
  seq: 3
}

post {
  url: http://localhost:3000/api/galaxy/places
  body: json
  auth: inherit
}

body:json {
  {
    "kind": "SYSTEM",
    "name": null,
    "x": 10,
    "y": -5,
    "region": "GU",
    "bodies": [
      {
        "kind": "STAR",
        "type": "orange",
        "children": [
          { "kind": "PLANET", "name": "Testworld", "type": "ocean", "radiusKm": 6000, "orbit": 1.1 }
        ]
      }
    ]
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
