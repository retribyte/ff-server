datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider   = "prisma-client-js"
  // Rust-free client: the query compiler is wasm and queries go through
  // @prisma/adapter-pg (see src/db.ts). Production runs on FreeBSD (NFSN),
  // which has no native Prisma engines. Run the Prisma CLI on Linux only.
  engineType = "client"
}

enum UserRole {
  USER
  ADMIN
}

enum MessageType {
  BOT_RESPONSE
  COMMAND
  QUOTE
  ACTION
  EMBED
  OTHER
}

enum ItemType {
  WEAPON
  EQUIPMENT
  ARTIFACT
  OTHER
}

enum EightBallAnswerType {
  YES
  NO
  MAYBE
}

enum StoryLineType {
  NARRATION // prose paragraph
  DIALOGUE // spoken line, colored by character
  ACTION // a reader/protagonist choice
  TRANSCRIPT // in-universe recording fragment (VCOMM etc.)
  BREAK // scene break
  HEADING // in-chapter section heading (prose sub-sections)
  IMAGE // a picture: a booru post (booruId), text = its alt text
}

enum StoryFormat {
  SCRIPT // narration and dialogue alternate as whole paragraphs (Vortox Machina)
  PROSE // novel-style: dialogue embedded inside narration paragraphs
}

model User {
  id                 Int          @id @unique @default(autoincrement())
  username           String       @unique
  email              String?      @unique
  password           String // hashed using bcrypt?
  role               UserRole
  icon               String? // Resolved booru image URL; if null, use identicon?
  iconBooruId        Int? // booru.vortox.space post the icon was taken from
  color              String? // dark-mode display color for characterless messages (e.g. the Vortox bot); hex
  bio                String?
  wikiUser           String?
  passwordChangedAt  DateTime? // Tokens issued before this are rejected
  mustChangePassword Boolean      @default(false) // Seeded/reset accounts pick their own password
  loginDisabled      Boolean      @default(false) // System accounts, suspended users
  characters         Character[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  messages           Message[]
  items              Item[]
  commentaries       Commentary[]
  stories            Story[]
  jobRuns            JobRun[]
}

model Character {
  id            Int            @id @unique @default(autoincrement())
  name          String
  creator       User           @relation(fields: [creatorId], references: [id])
  creatorId     Int
  messages      Message[]
  image         String?
  color         String?
  colorLight    String?
  blurb         String?
  storyLines    StoryLine[]
  storySegments StorySegment[]
  personas      Persona[]
  slug          String         @unique
  // campaigns an admin added this character to the cast of
  mainIn        Season[]       @relation("MainCharacters")

  @@unique([creatorId, name])
  @@map("characters")
}

// Uploaded avatar PNGs (see src/character/avatar.service.ts). Content-addressed:
// Character.image / Persona.image hold /api/avatars/<sha256>.png, so the bytes
// stay out of the per-message payloads that embed those columns, and a replaced
// avatar gets a new URL past the immutable cache. Replaced images stay in the
// table (a few hundred bytes each, and another record may share them).
model AvatarImage {
  sha256    String   @id
  data      Bytes
  createdAt DateTime @default(now())

  @@map("avatar_images")
}

// How a character is presented for some stretch of the archive
model Persona {
  id            Int            @id @unique @default(autoincrement())
  name          String? // null -> canonical name shows
  label         String? // admin-facing handle; never rendered in transcripts
  slug          String?        @unique // null for unnamed personas
  image         String?
  color         String?
  // null -> an NPC persona: a named voice with no Character behind it
  // ("Enemy A", "Llamanian Guard"). NPC personas always have a name, never a
  // slug or a page, and are unique by lower(name) via a partial unique index
  // (personas_npc_name_key) that prisma/scripts/create-triggers.ts installs;
  // @@unique([characterId, name]) can't cover them, since NULLs are distinct.
  character     Character?     @relation(fields: [characterId], references: [id], onDelete: Cascade)
  characterId   Int?
  messages      Message[]
  storyLines    StoryLine[]
  storySegments StorySegment[]

  @@unique([characterId, name]) // Postgres: NULLs distinct -> many name-less personas allowed
  @@map("personas")
}

enum SeasonKind {
  MAINLINE
  SIDE
  PLANNED
}

model Season {
  title          String      @id @unique
  episodes       Episode[]
  stories        Story[]
  slug           String      @unique
  kind           SeasonKind  @default(SIDE)
  mainCharacters Character[] @relation("MainCharacters")

  @@map("seasons")
}

model Episode {
  title         String    @unique
  season        Season    @relation(fields: [seasonTitle], references: [title])
  episode_no    Int
  messages      Message[]
  seasonTitle   String
  summary       String?
  playedDate    DateTime?
  slug          String    @unique
  // rewritten from memory, not recovered from logs
  reconstructed Boolean   @default(false)

  @@id([seasonTitle, episode_no])
  @@map("episodes")
}

model Message {
  episode      Episode      @relation(fields: [episodeTitle], references: [title])
  messageNo    Int
  episodeTitle String
  player       User         @relation(fields: [playerId], references: [id])
  playerId     Int
  character    Character?   @relation(fields: [characterId], references: [id], onDelete: Restrict) // archive immutability: a character in the archive can't be deleted out from under its lines
  characterId  Int?
  // Single-column FK. That the persona belongs to this message's character
  // (both null for an NPC line) is enforced by the messages_persona_match
  // trigger from prisma/scripts/create-triggers.ts, not by a composite FK:
  // a composite FK skips the check whenever characterId is null (MATCH SIMPLE).
  persona      Persona?     @relation(fields: [personaId], references: [id], onDelete: Restrict)
  personaId    Int?
  timestamp    DateTime?
  type         MessageType
  text         String
  commentaries Commentary[]

  @@id([episodeTitle, messageNo])
  @@map("messages")
}

// A margin note on a transcript message or on a story line: exactly one of
// the two (the commentaries_one_target check, prisma/prod-sql). A story line's
// notes go with it when it's deleted; a story revision moves them to the new
// line first (replaceStoryContent).
model Commentary {
  id                  Int        @id @unique @default(autoincrement())
  creator             User       @relation(fields: [creatorId], references: [id])
  creatorId           Int
  message             Message?   @relation(fields: [messageEpisodeTitle, messageNo], references: [episodeTitle, messageNo], onDelete: Restrict) // as before it was optional
  messageEpisodeTitle String?
  messageNo           Int?
  storyLine           StoryLine? @relation(fields: [storyLineId], references: [id], onDelete: Cascade)
  storyLineId         Int?
  content             String

  @@index([storyLineId])
  @@map("commentaries")
}

// Prose works (short stories, the Vortox Machina chronicle). Unlike the
// season/episode/message hierarchy these use numeric ids + a unique slug so
// renames never cascade through child rows.
model Story {
  id            Int            @id @unique @default(autoincrement())
  slug          String         @unique
  title         String         @unique
  blurb         String?
  authors       User[] // co-written stories have several
  publishedDate DateTime? // real-world publication; an in-universe date would be a GUY Int
  themeColor    String?
  themeColor2   String?
  format        StoryFormat    @default(PROSE) // dialogue presentation: script vs novel-style prose
  // false = outside the universe's continuity
  canon         Boolean        @default(true)
  // Campaign this story belongs to, if any (FF3 short stories etc.). Same
  // title FK as Episode.seasonTitle; a season can hold stories but no episodes.
  season        Season?        @relation(fields: [seasonTitle], references: [title], onDelete: SetNull)
  seasonTitle   String?
  chapters      StoryChapter[]
  // Duplicate-import detection: sha256 of the lines as imported (per chapter,
  // in order, [type, text] per line — see storyContentHash in story.service.ts).
  // Fingerprints the manuscript at import time; later line edits don't update
  // it. Null for stories that predate it until backfill:story-hashes runs.
  contentHash   String?        @unique
  // How the last Google Doc import read the doc: {format, colors: {"#rrggbb":
  // speaker name | null (narration) | "?" (unnamed NPCs)}}. A revision of the
  // story pre-fills its color form from this and only asks about new colors.
  // Null for stories imported any other way.
  importMeta    Json?

  @@map("stories")
}

model StoryChapter {
  id         Int         @id @unique @default(autoincrement())
  story      Story       @relation(fields: [storyId], references: [id])
  storyId    Int
  chapter_no Int
  title      String?
  lines      StoryLine[]

  @@unique([storyId, chapter_no])
  @@map("story_chapters")
}

model StoryLine {
  id           Int            @id @unique @default(autoincrement())
  chapter      StoryChapter   @relation(fields: [chapterId], references: [id])
  chapterId    Int
  line_no      Int // 1-based within chapter; deep-link anchor
  type         StoryLineType
  text         String
  // The line's voice, the same rule as Message: a character alone, a character
  // shown as one of its personas, or an NPC persona alone (characterId null).
  // The story_lines_persona_match trigger (prisma/scripts/create-triggers.ts)
  // keeps the persona on the line's character.
  character    Character?     @relation(fields: [characterId], references: [id], onDelete: Restrict) // same as Message.character
  characterId  Int?
  persona      Persona?       @relation(fields: [personaId], references: [id], onDelete: Restrict)
  personaId    Int?
  // Sub-paragraph dialogue spans for novel-style prose (NARRATION lines only).
  // Their texts concatenate verbatim to exactly `text`, so search/scan/
  // highlight keep working on `text`.
  segments     StorySegment[]
  // IMAGE lines: the booru.vortox.space post that holds the picture, and its
  // file URL, resolved from the booru at import (served via the image proxy)
  booruId      Int?
  imageUrl     String?
  commentaries Commentary[]

  @@unique([chapterId, line_no])
  @@index([personaId])
  @@map("story_lines")
}

// One span of a segmented NARRATION line: dialogue when it has a voice
// (same rule as StoryLine/Message: character, character + persona, or an NPC
// persona alone; story_segments_persona_match enforces it), narration when
// not. Replaced wholesale whenever its line changes.
model StorySegment {
  id          Int        @id @default(autoincrement())
  line        StoryLine  @relation(fields: [lineId], references: [id], onDelete: Cascade)
  lineId      Int
  position    Int // 0-based order within the line
  text        String
  character   Character? @relation(fields: [characterId], references: [id], onDelete: Restrict)
  characterId Int?
  persona     Persona?   @relation(fields: [personaId], references: [id], onDelete: Restrict)
  personaId   Int?
  italic      Boolean    @default(false)
  bold        Boolean    @default(false)

  @@unique([lineId, position])
  @@index([characterId])
  @@index([personaId])
  @@map("story_segments")
}

model Item {
  id          Int      @id @unique @default(autoincrement())
  name        String
  itemType    ItemType
  description String
  image       String?
  creator     User     @relation(fields: [creatorId], references: [id])
  creatorId   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  slug        String   @unique

  @@map("items")
}

model EightBallAnswer {
  id   Int                 @id @default(autoincrement())
  type EightBallAnswerType
  text String

  @@map("eight_ball_answers")
}

// Cache-aside read of the wiki's Bucket data for characters/items
// (see docs/notes/PLAN-wiki-cache.md). `data: null` is a first-class negative-cache
// entry (confirmed "no wiki page"), not an error state — most DB slugs don't
// have one. TTL is read at query time in wiki.service.ts, not stored per-row.
model WikiCache {
  bucket    String
  slug      String
  data      Json?
  fetchedAt DateTime @default(now())

  @@id([bucket, slug])
  @@map("wiki_cache")
}

enum JobStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

// Small server-kept state an admin feature needs between runs, by key. Unused
// since Vortox Machina moved to the story importer (its speaker codes are
// Story.importMeta.codes now); left for the next feature that needs one.
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @default(now()) @updatedAt

  @@map("app_settings")
}

// One run of an admin job (the /admin page): what ran, who ran it, its log
model JobRun {
  id         Int       @id @default(autoincrement())
  job        String
  dryRun     Boolean   @default(false)
  status     JobStatus @default(RUNNING)
  summary    String?
  log        String    @default("")
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId     Int?

  @@index([job, startedAt])
  @@map("job_runs")
}

enum ViewKind {
  EPISODE
  STORY
}

// Daily page-view counters, aggregate only (no per-user rows): `member` counts
// views by signed-in users, `anonymous` the rest. `slug` is the episode's or
// story's permanent slug; there's no FK because it spans two tables.
model ViewCount {
  kind      ViewKind
  slug      String
  day       DateTime @db.Date // UTC
  member    Int      @default(0)
  anonymous Int      @default(0)

  @@id([kind, slug, day])
  @@index([day])
  @@map("view_counts")
}
