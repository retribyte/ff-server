datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider   = "prisma-client-js"
  // Rust-free client: the query compiler is wasm and queries go through
  // @prisma/adapter-pg (see src/db.ts). Production runs on FreeBSD (NFSN),
  // which has no native Prisma engines. Run the Prisma CLI on Linux only.
  engineType = "client"
}

enum UserRole {
  USER
  ADMIN
}

enum MessageType {
  BOT_RESPONSE
  COMMAND
  QUOTE
  ACTION
  EMBED
  OTHER
}

enum ItemType {
  WEAPON
  EQUIPMENT
  ARTIFACT
  OTHER
}

enum EightBallAnswerType {
  YES
  NO
  MAYBE
}

enum StoryLineType {
  NARRATION // prose paragraph
  DIALOGUE // spoken line, colored by character
  ACTION // a reader/protagonist choice
  TRANSCRIPT // in-universe recording fragment (VCOMM etc.)
  BREAK // scene break
  HEADING // in-chapter section heading (prose sub-sections)
  IMAGE // a picture: a booru post (booruId), text = its alt text
}

enum StoryFormat {
  SCRIPT // narration and dialogue alternate as whole paragraphs (Vortox Machina)
  PROSE // novel-style: dialogue embedded inside narration paragraphs
}

model User {
  id                 Int             @id @unique @default(autoincrement())
  username           String          @unique
  email              String?         @unique
  password           String // hashed using bcrypt?
  role               UserRole
  icon               String? // Resolved booru image URL; if null, use identicon?
  iconBooruId        Int? // booru.vortox.space post the icon was taken from
  color              String? // dark-mode display color for characterless messages (e.g. the Vortox bot); hex
  bio                String?
  wikiUser           String?
  passwordChangedAt  DateTime? // Tokens issued before this are rejected
  mustChangePassword Boolean         @default(false) // Seeded/reset accounts pick their own password
  loginDisabled      Boolean         @default(false) // System accounts, suspended users
  characters         Character[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  messages           Message[]
  items              Item[]
  commentaries       Commentary[]
  stories            Story[]
  jobRuns            JobRun[]
  portraits          Portrait[]
  mapPlaces          MapPlace[]
  travelogueTags     TravelogueTag[]
}

model Character {
  id            Int            @id @unique @default(autoincrement())
  name          String
  creator       User           @relation(fields: [creatorId], references: [id])
  creatorId     Int
  messages      Message[]
  image         String?
  color         String?
  colorLight    String?
  blurb         String?
  storyLines    StoryLine[]
  storySegments StorySegment[]
  personas      Persona[]
  slug          String         @unique
  // campaigns an admin added this character to the cast of
  mainIn        Season[]       @relation("MainCharacters")

  @@unique([creatorId, name])
  @@map("characters")
}

// Uploaded avatar PNGs (see src/character/avatar.service.ts). Content-addressed:
// Character.image / Persona.image hold /api/avatars/<sha256>.png, so the bytes
// stay out of the per-message payloads that embed those columns, and a replaced
// avatar gets a new URL past the immutable cache. Replaced images stay in the
// table (a few hundred bytes each, and another record may share them).
model AvatarImage {
  sha256    String   @id
  data      Bytes
  createdAt DateTime @default(now())

  @@map("avatar_images")
}

// How a character is presented for some stretch of the archive
model Persona {
  id            Int            @id @unique @default(autoincrement())
  name          String? // null -> canonical name shows
  label         String? // admin-facing handle; never rendered in transcripts
  slug          String?        @unique // null for unnamed personas
  image         String?
  color         String?
  // null -> an NPC persona: a named voice with no Character behind it
  // ("Enemy A", "Llamanian Guard"). NPC personas always have a name, never a
  // slug or a page, and are unique by lower(name) via a partial unique index
  // (personas_npc_name_key) that prisma/scripts/create-triggers.ts installs;
  // @@unique([characterId, name]) can't cover them, since NULLs are distinct.
  character     Character?     @relation(fields: [characterId], references: [id], onDelete: Cascade)
  characterId   Int?
  messages      Message[]
  storyLines    StoryLine[]
  storySegments StorySegment[]

  @@unique([characterId, name]) // Postgres: NULLs distinct -> many name-less personas allowed
  @@map("personas")
}

enum SeasonKind {
  MAINLINE
  SIDE
  PLANNED
}

model Season {
  title          String      @id @unique
  episodes       Episode[]
  stories        Story[]
  slug           String      @unique
  kind           SeasonKind  @default(SIDE)
  mainCharacters Character[] @relation("MainCharacters")

  @@map("seasons")
}

model Episode {
  title         String    @unique
  season        Season    @relation(fields: [seasonTitle], references: [title])
  episode_no    Int
  messages      Message[]
  seasonTitle   String
  summary       String?
  playedDate    DateTime?
  slug          String    @unique
  // rewritten from memory, not recovered from logs
  reconstructed Boolean   @default(false)

  @@id([seasonTitle, episode_no])
  @@map("episodes")
}

model Message {
  episode      Episode      @relation(fields: [episodeTitle], references: [title])
  messageNo    Int
  episodeTitle String
  player       User         @relation(fields: [playerId], references: [id])
  playerId     Int
  character    Character?   @relation(fields: [characterId], references: [id], onDelete: Restrict) // archive immutability: a character in the archive can't be deleted out from under its lines
  characterId  Int?
  // Single-column FK. That the persona belongs to this message's character
  // (both null for an NPC line) is enforced by the messages_persona_match
  // trigger from prisma/scripts/create-triggers.ts, not by a composite FK:
  // a composite FK skips the check whenever characterId is null (MATCH SIMPLE).
  persona      Persona?     @relation(fields: [personaId], references: [id], onDelete: Restrict)
  personaId    Int?
  timestamp    DateTime?
  type         MessageType
  text         String
  commentaries Commentary[]

  @@id([episodeTitle, messageNo])
  @@map("messages")
}

// A margin note on a transcript message or on a story line: exactly one of
// the two (the commentaries_one_target check, prisma/prod-sql). A story line's
// notes go with it when it's deleted; a story revision moves them to the new
// line first (replaceStoryContent).
model Commentary {
  id                  Int        @id @unique @default(autoincrement())
  creator             User       @relation(fields: [creatorId], references: [id])
  creatorId           Int
  message             Message?   @relation(fields: [messageEpisodeTitle, messageNo], references: [episodeTitle, messageNo], onDelete: Restrict) // as before it was optional
  messageEpisodeTitle String?
  messageNo           Int?
  storyLine           StoryLine? @relation(fields: [storyLineId], references: [id], onDelete: Cascade)
  storyLineId         Int?
  content             String

  @@index([storyLineId])
  @@map("commentaries")
}

// Prose works (short stories, the Vortox Machina chronicle). Unlike the
// season/episode/message hierarchy these use numeric ids + a unique slug so
// renames never cascade through child rows.
model Story {
  id            Int            @id @unique @default(autoincrement())
  slug          String         @unique
  title         String         @unique
  blurb         String?
  authors       User[] // co-written stories have several
  publishedDate DateTime? // real-world publication; an in-universe date would be a GUY Int
  themeColor    String?
  themeColor2   String?
  format        StoryFormat    @default(PROSE) // dialogue presentation: script vs novel-style prose
  // false = outside the universe's continuity
  canon         Boolean        @default(true)
  // Campaign this story belongs to, if any (FF3 short stories etc.). Same
  // title FK as Episode.seasonTitle; a season can hold stories but no episodes.
  season        Season?        @relation(fields: [seasonTitle], references: [title], onDelete: SetNull)
  seasonTitle   String?
  chapters      StoryChapter[]
  // Duplicate-import detection: sha256 of the lines as imported (per chapter,
  // in order, [type, text] per line — see storyContentHash in story.service.ts).
  // Fingerprints the manuscript at import time; later line edits don't update
  // it. Null for stories that predate it until backfill:story-hashes runs.
  contentHash   String?        @unique
  // How the last Google Doc import read the doc: {format, colors: {"#rrggbb":
  // speaker name | null (narration) | "?" (unnamed NPCs)}}. A revision of the
  // story pre-fills its color form from this and only asks about new colors.
  // Null for stories imported any other way.
  importMeta    Json?

  @@map("stories")
}

model StoryChapter {
  id         Int         @id @unique @default(autoincrement())
  story      Story       @relation(fields: [storyId], references: [id])
  storyId    Int
  chapter_no Int
  title      String?
  lines      StoryLine[]

  @@unique([storyId, chapter_no])
  @@map("story_chapters")
}

model StoryLine {
  id           Int            @id @unique @default(autoincrement())
  chapter      StoryChapter   @relation(fields: [chapterId], references: [id])
  chapterId    Int
  line_no      Int // 1-based within chapter; deep-link anchor
  type         StoryLineType
  text         String
  // The line's voice, the same rule as Message: a character alone, a character
  // shown as one of its personas, or an NPC persona alone (characterId null).
  // The story_lines_persona_match trigger (prisma/scripts/create-triggers.ts)
  // keeps the persona on the line's character.
  character    Character?     @relation(fields: [characterId], references: [id], onDelete: Restrict) // same as Message.character
  characterId  Int?
  persona      Persona?       @relation(fields: [personaId], references: [id], onDelete: Restrict)
  personaId    Int?
  // Sub-paragraph dialogue spans for novel-style prose (NARRATION lines only).
  // Their texts concatenate verbatim to exactly `text`, so search/scan/
  // highlight keep working on `text`.
  segments     StorySegment[]
  // IMAGE lines: the booru.vortox.space post that holds the picture, and its
  // file URL, resolved from the booru at import (served via the image proxy)
  booruId      Int?
  imageUrl     String?
  commentaries Commentary[]

  @@unique([chapterId, line_no])
  @@index([personaId])
  @@map("story_lines")
}

// One span of a segmented NARRATION line: dialogue when it has a voice
// (same rule as StoryLine/Message: character, character + persona, or an NPC
// persona alone; story_segments_persona_match enforces it), narration when
// not. Replaced wholesale whenever its line changes.
model StorySegment {
  id          Int        @id @default(autoincrement())
  line        StoryLine  @relation(fields: [lineId], references: [id], onDelete: Cascade)
  lineId      Int
  position    Int // 0-based order within the line
  text        String
  character   Character? @relation(fields: [characterId], references: [id], onDelete: Restrict)
  characterId Int?
  persona     Persona?   @relation(fields: [personaId], references: [id], onDelete: Restrict)
  personaId   Int?
  italic      Boolean    @default(false)
  bold        Boolean    @default(false)

  @@unique([lineId, position])
  @@index([characterId])
  @@index([personaId])
  @@map("story_segments")
}

model Item {
  id          Int      @id @unique @default(autoincrement())
  name        String
  itemType    ItemType
  description String
  image       String?
  creator     User     @relation(fields: [creatorId], references: [id])
  creatorId   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  slug        String   @unique

  @@map("items")
}

model EightBallAnswer {
  id   Int                 @id @default(autoincrement())
  type EightBallAnswerType
  text String

  @@map("eight_ball_answers")
}

// Cache-aside read of the wiki's Bucket data for characters/items
// (see docs/notes/PLAN-wiki-cache.md). `data: null` is a first-class negative-cache
// entry (confirmed "no wiki page"), not an error state — most DB slugs don't
// have one. TTL is read at query time in wiki.service.ts, not stored per-row.
model WikiCache {
  bucket    String
  slug      String
  data      Json?
  fetchedAt DateTime @default(now())

  @@id([bucket, slug])
  @@map("wiki_cache")
}

enum JobStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

// Small server-kept state an admin feature needs between runs, by key. Unused
// since Vortox Machina moved to the story importer (its speaker codes are
// Story.importMeta.codes now); left for the next feature that needs one.
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @default(now()) @updatedAt

  @@map("app_settings")
}

// One run of an admin job (the /admin page): what ran, who ran it, its log
model JobRun {
  id         Int       @id @default(autoincrement())
  job        String
  dryRun     Boolean   @default(false)
  status     JobStatus @default(RUNNING)
  summary    String?
  log        String    @default("")
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId     Int?

  @@index([job, startedAt])
  @@map("job_runs")
}

enum ViewKind {
  EPISODE
  STORY
}

// Daily page-view counters, aggregate only (no per-user rows): `member` counts
// views by signed-in users, `anonymous` the rest. `slug` is the episode's or
// story's permanent slug; there's no FK because it spans two tables.
model ViewCount {
  kind      ViewKind
  slug      String
  day       DateTime @db.Date // UTC
  member    Int      @default(0)
  anonymous Int      @default(0)

  @@id([kind, slug, day])
  @@index([day])
  @@map("view_counts")
}

// Portrait creator (ff-site /portraits). The sprite files themselves live in a
// directory on the server (PORTRAIT_BUNDLE_DIR), never in the database or in git.
// A mod is switched by `enabled`; a bundle folder with no row counts as enabled, and
// a row with no folder is a remembered switch. `itemsOnlyFor`: species kinds (lowercase)
// that may wear this mod's clothing; empty = anyone.
model PortraitMod {
  id           String    @id // bundle folder name (the workshop id, or "vanilla")
  name         String
  enabled      Boolean   @default(true)
  itemsOnlyFor String[]
  // Set when a member uploads the folder through the site (not by the push script)
  uploadedBy   String?
  uploadedAt   DateTime?

  @@map("portrait_mods")
}

// One race in the creator's list (a species can be several races). Mirrors RaceDef
// in ff-site's src/lib/portrait/races.ts; `position` is the list order.
model PortraitRace {
  id         String   @id
  species    String?
  name       String?
  descriptor String?
  category   String?
  exclude    String[]
  prefer     String[]
  hidden     Boolean  @default(false)
  lock       Json?
  position   Int

  @@map("portrait_races")
}

// Whole-bundle settings, one row each: `categories` (string[]), `hideItemPattern`
// (string), `hideItems` (string[]), `erase` ({"<mod id><image path>": [[x, y], ...]}).
model PortraitSetting {
  key   String @id
  value Json

  @@map("portrait_settings")
}

// A portrait a member made in the creator and kept: the recipe to reopen it and the
// rendered PNG. Private to its owner (and admins); it need not belong to a character.
model Portrait {
  id        Int      @id @default(autoincrement())
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId   Int
  name      String
  race      String // the creator's race id the recipe was made with
  recipe    Json
  image     Bytes // PNG, 1 pixel per sprite pixel
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@map("portraits")
}

// ---------- Galaxy map (ff-site /galaxy; src/galaxy/) ----------

enum MapPlaceKind {
  SYSTEM // a star with whatever orbits it
  LANDMARK // anything else pinned to the map: a station in open space, a nebula, a district
}

enum MapBodyKind {
  STAR
  PLANET
  MOON
  STATION
  // An asteroid belt round a star, or a ring round a planet or moon
  BELT
}

// The four "somewhere in ..." regions a place can be dropped into
enum MapRegion {
  GU
  ADE
  LR
  RIM
}

// One pin on the galaxy map. Any member adds one; its creator (or whoever it was
// seeded with) owns it and everything in it, and the owner or an admin edits it.
// `slug` is the shared wiki identity (Final Frontier Wiki:Slugs), so the site can
// pull the wiki's text and picture for it; null while the place has no name.
model MapPlace {
  id          Int             @id @default(autoincrement())
  kind        MapPlaceKind
  // null -> a placeholder system: a planet was added before anyone named its star
  name        String?
  slug        String?         @unique
  // Position in the Galactic Sector Grid frame: klyr, Sagittarius A at the origin,
  // the bar along +y, z out of the disk
  x           Float
  y           Float
  z           Float           @default(0)
  // Set when the place was put "somewhere in" a region: x/y/z are then a random
  // point inside it, not a known position. Null = placed by hand.
  region      MapRegion?
  category    String? // landmarks only: a key of LANDMARK_CATEGORIES (src/galaxy/galaxy.validation.ts)
  description String?
  creator     User            @relation(fields: [creatorId], references: [id])
  creatorId   Int
  bodies      MapBody[]
  travelogue  TravelogueTag[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([creatorId])
  @@map("map_places")
}

// A star, planet, moon, station or belt of a SYSTEM place, in one self-referential
// table: the star has no parent, a planet orbits the star, a moon orbits a planet, a
// station or a belt orbits any of them (a belt round a planet or moon is its ring).
// Owned through its place. Deleting a body deletes what orbits it.
model MapBody {
  id          Int             @id @default(autoincrement())
  place       MapPlace        @relation(fields: [placeId], references: [id], onDelete: Cascade)
  placeId     Int
  parent      MapBody?        @relation("orbit", fields: [parentId], references: [id], onDelete: Cascade)
  parentId    Int?
  children    MapBody[]       @relation("orbit")
  kind        MapBodyKind
  // null for a star nobody has named, and for a planet or moon known only by its GU
  // designation (Sol-3, Sol-3a), which the site works out from the star's name
  name        String?
  slug        String?         @unique // wiki identity, as MapPlace.slug
  // Stars: a key of STAR_TYPES. Everything else: a key of COMPOSITIONS.
  type        String
  radiusKm    Float? // null for stars: they take their size from the type
  // Planets: AU from the star. Moons and stations: km from the parent. Belts: the middle
  // of the band, AU from a star or km from a planet or moon. Null for the star.
  orbit       Float?
  // Belts only: how wide the band is, in the unit of its orbit
  width       Float?
  // Planets only: "this is planet N of its star", for a planet whose inner neighbours
  // are not on the map yet. Null = it counts from the planets inside its orbit.
  ordinal     Int?
  // Stations only, entered by the member (the map never assigns them): the GUY year it was
  // built and which iteration of the station it is. Its designation is <primary>.<year>-<iteration>
  // (Sol-3.3016-02); without a year it has none.
  builtYear   Int?
  iteration   Int?
  color       String? // "#rrggbb" override of the type's color
  description String?
  travelogue  TravelogueTag[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([placeId])
  @@index([parentId])
  @@map("map_bodies")
}

// "This episode happened here", tagged by hand. A tag is on a place, or on one body
// of it (bodyId set). The episode is its permanent slug with no FK, as in ViewCount:
// an episode re-import deletes and recreates the row, and the tags must outlive that.
model TravelogueTag {
  id          Int      @id @default(autoincrement())
  place       MapPlace @relation(fields: [placeId], references: [id], onDelete: Cascade)
  placeId     Int
  body        MapBody? @relation(fields: [bodyId], references: [id], onDelete: Cascade)
  bodyId      Int?
  episodeSlug String
  creator     User     @relation(fields: [creatorId], references: [id])
  creatorId   Int
  createdAt   DateTime @default(now())

  @@index([placeId])
  @@index([episodeSlug])
  @@map("map_travelogue")
}
